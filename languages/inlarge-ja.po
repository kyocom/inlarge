#: includes/class-inlarge-admin.php:72 includes/class-inlarge-settings.php:36
#: includes/class-inlarge-settings.php:37 includes/class-inlarge-settings.php:101
msgid "Inlarge"
msgstr "Inlarge"

#: includes/class-inlarge-admin.php:95
msgid "Enable image enlargement for this post"
msgstr "この投稿で画像の拡大を有効にする"

#: includes/class-inlarge-admin.php:99
msgid "Checked by default. Uncheck to turn enlargement off for this post only."
msgstr "初期状態はオンです。この投稿だけ拡大を止めたいときは、チェックを外してください。"

#: includes/class-inlarge-admin.php:105
msgid "Apply to WordPress galleries"
msgstr "WordPress のギャラリーにも適用する"

#: includes/class-inlarge-admin.php:109
msgid "Off by default. Check this to make images in WordPress galleries enlargeable regardless of their link setting."
msgstr "初期状態はオフ。オンにすると、リンク設定にかかわらずギャラリー内の画像も拡大できます。"

#: includes/class-inlarge-settings.php:84
msgid "Settings"
msgstr "設定"

#: includes/class-inlarge-settings.php:104
msgid "Enabled post types"
msgstr "有効にする投稿タイプ"

#: includes/class-inlarge-settings.php:106
msgid "Image enlargement runs only on the post types you check here. Unchecked post types are disabled."
msgstr "ここでチェックした投稿タイプでのみ拡大が動きます。外したものは対象になりません。"

#: includes/class-inlarge-settings.php:111
msgid "Post types"
msgstr "投稿タイプ"

#: includes/class-inlarge-settings.php:129
msgid "No eligible post types were found."
msgstr "対象となる投稿タイプが見つかりません。"
